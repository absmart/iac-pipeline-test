# Creates the Terraform state storage of the End-to-end test pipeline. Generated by IaC Pipeline Planner.
#
# Run it with scripts/bootstrap-state.sh: the first run applies with local state, then moves
# this configuration's own state into e2etfstateprdeus201st (container bootstrap).

terraform {
  required_version = ">= 1.10"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  alias               = "dev"
  subscription_id     = "b8d7c6ba-ef18-484c-ad5c-da10d1e329fd"
  environment         = "public"
  storage_use_azuread = true
  features {}
}

module "state_dev" {
  source    = "./modules/state-storage"
  providers = { azurerm = azurerm.dev }

  resource_group_name  = "e2e-tfstate-dev-eus2-01-rg"
  storage_account_name = "e2etfstatedeveus201st"
  location             = "eastus2"
  replication_type     = "LRS"
  containers           = ["tfstate-dev"]
  lock                 = true
}

module "state_prd" {
  source    = "./modules/state-storage"
  providers = { azurerm = azurerm.dev }

  resource_group_name  = "e2e-tfstate-prd-eus2-01-rg"
  storage_account_name = "e2etfstateprdeus201st"
  location             = "eastus2"
  replication_type     = "LRS"
  containers           = ["tfstate-prd", "bootstrap"]
  lock                 = true
}

output "state_accounts" {
  description = "Resource IDs of the state storage accounts."
  value = {
    dev = module.state_dev.id
    prd = module.state_prd.id
  }
}
